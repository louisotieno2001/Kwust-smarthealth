<%- include('../partials/portal-start', { title: 'Appointments' }) %>

<main id="main" class="container">
  <%- include('../partials/flash') %>
  <div class="page-header">
    <div>
      <span class="eyebrow">Clinical schedule</span>
      <h1>Appointments</h1>
      <p>Manage appointments for the slots you own.</p>
    </div>
    <div class="page-actions"><a href="/clinician/slots" class="btn btn-secondary">Manage slots</a></div>
  </div>

  <section class="card">
    <% if (appointments.length) { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Date</th><th>Time</th><th>Student</th><th>Reason</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% appointments.forEach((appointment) => { %>
              <tr>
                <td class="nowrap"><%= formatDate(appointment.slot_id?.date) %></td>
                <td class="nowrap"><%= formatTime(appointment.slot_id?.start_time) %> – <%= formatTime(appointment.slot_id?.end_time) %></td>
                <td><%= appointment.student_id?.full_name %><br><small class="muted"><%= appointment.student_id?.admission_number %></small></td>
                <td><%= appointment.reason || '—' %></td>
                <td><span class="badge badge-<%= statusClass(appointment.status) %>"><%= statusLabel(appointment.status) %></span></td>
                <td class="table-actions">
                  <% if (appointment.status === 'booked') { %>
                    <a href="/clinician/records/new?student_id=<%= appointment.student_id?.id %>&appointment_id=<%= appointment.id %>" class="btn btn-primary btn-sm">Record</a>
                    <form action="/clinician/appointments/<%= appointment.id %>/complete" method="post">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-ghost btn-sm">Complete</button>
                    </form>
                    <form action="/clinician/appointments/<%= appointment.id %>/cancel" method="post" data-confirm="Cancel this appointment?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-ghost btn-sm">Cancel</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state"><strong>No appointments yet</strong><span>Create slots so students can book appointments.</span></div>
    <% } %>
  </section>
</main>

<%- include('../partials/portal-end') %>

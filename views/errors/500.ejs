<%- include('../partials/head', { title: 'Something went wrong' }) %>
<%- include('../partials/header') %>
<main id="main" class="container">
  <section class="card center-card-sm">
    <span class="eyebrow">500</span>
    <h1><%= title %></h1>
    <p class="muted">The system could not complete your request. Please try again.</p>
    <% if (typeof message !== 'undefined' && message) { %><p class="helper"><%= message %></p><% } %>
    <a href="/" class="btn btn-primary">Return home</a>
  </section>
</main>
<%- include('../partials/footer') %>

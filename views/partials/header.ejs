<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/">
      <img src="/images/kwust.jpg" alt="KWUST logo" class="brand-logo">
      <span class="brand-text">
        <strong>KWUST SmartHealth</strong>
        <!-- <small>University Health Center</small> -->
      </span>
    </a>

    <div class="header-actions">
      <button type="button" class="icon-button" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
        <span class="theme-icon" aria-hidden="true">◐</span>
      </button>

      <% if (typeof user !== 'undefined' && user) { %>
        <span class="user-chip" title="<%= user.full_name %>">
          <span class="avatar"><%= initials(user.full_name) %></span>
          <span class="user-chip-text">
            <strong><%= user.full_name %></strong>
            <small><%= roleLabel(user.role) %></small>
          </span>
        </span>
        <form action="/auth/logout" method="post" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-ghost btn-sm">Log out</button>
        </form>
      <% } else { %>
        <a href="/login" class="btn btn-ghost btn-sm">Log in</a>
        <a href="/signup" class="btn btn-primary btn-sm">Sign up</a>
      <% } %>
    </div>
  </div>
</header>

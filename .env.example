NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=KWUST_SmartHealth
DB_USER=postgres
DB_PASSWORD=postgres

# Directus
DIRECTUS_URL=http://localhost:8055
DIRECTUS_PUBLIC_URL=http://localhost:8055
DIRECTUS_KEY=change_me_directus_key
DIRECTUS_SECRET=change_me_directus_secret
DIRECTUS_TOKEN=
DIRECTUS_ADMIN_EMAIL=admin@kwust.ac.ke
DIRECTUS_ADMIN_PASSWORD=change_me_admin_password

# Authentication
JWT_SECRET=change_me_jwt_secret
SESSION_SECRET=change_me_session_secret
ADMIN_SIGNUP_CODE=change_me_admin_invite
BCRYPT_ROUNDS=12

# AI health assistant (providers are tried in order; add at least one key)
AI_PROVIDER_ORDER=gemini,openai,anthropic
AI_TIMEOUT_MS=15000
AI_MAX_TOKENS=1024

# Google Gemini
GEMINI_API_KEY=change_me_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (or any OpenAI-compatible API via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

# Server
SERVER_PORT=5000

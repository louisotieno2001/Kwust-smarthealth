<%- include('../partials/portal-start', { title: 'Medical records oversight' }) %>

<main id="main" class="container">
  <%- include('../partials/flash') %>
  <div class="page-header">
    <div>
      <span class="eyebrow">Oversight</span>
      <h1>Medical records</h1>
      <p>Review all medical records across the health center.</p>
    </div>
  </div>

  <form class="filter-bar" action="/admin/records" method="get">
    <div class="field">
      <label for="q">Search</label>
      <input id="q" name="q" type="search" value="<%= q %>" placeholder="Student, admission number, diagnosis">
    </div>
    <div class="field">
      <label for="diagnosis">Diagnosis</label>
      <input id="diagnosis" name="diagnosis" type="search" value="<%= diagnosis %>" placeholder="Filter by diagnosis">
    </div>
    <div class="field">
      <label>&nbsp;</label>
      <button type="submit" class="btn btn-secondary">Search</button>
    </div>
  </form>

  <section class="card">
    <% if (records.length) { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Visit date</th><th>Student</th><th>Admission no.</th><th>Clinician</th><th>Diagnosis</th><th>Medicines</th><th></th></tr></thead>
          <tbody>
            <% records.forEach((record) => { %>
              <tr>
                <td class="nowrap"><%= formatDate(record.visit_date) %></td>
                <td><%= record.student_id?.full_name %></td>
                <td><%= record.student_id?.admission_number %></td>
                <td><%= record.clinician_id?.full_name %></td>
                <td><%= record.diagnosis %></td>
                <td><%= (record.prescriptions || []).length %></td>
                <td class="table-actions">
                  <a href="/admin/records/<%= record.id %>" class="btn btn-ghost btn-sm">View</a>
                  <a href="/admin/records/<%= record.id %>/pdf" class="btn btn-secondary btn-sm">PDF</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state"><strong>No records found</strong><span>Medical records will appear here.</span></div>
    <% } %>
  </section>
</main>

<%- include('../partials/portal-end') %>

<%- include('../partials/portal-start', { title: 'System reports' }) %>

<main id="main" class="container">
  <%- include('../partials/flash') %>
  <div class="page-header">
    <div>
      <span class="eyebrow">Analytics</span>
      <h1>System reports</h1>
      <p>High-level operational insights for the health center.</p>
    </div>
  </div>

  <section class="stat-grid">
    <article class="stat-card">
      <div class="stat-label">Students</div>
      <div class="stat-value"><%= stats.studentCount %></div>
    </article>
    <article class="stat-card">
      <div class="stat-label">Clinicians</div>
      <div class="stat-value"><%= stats.clinicianCount %></div>
    </article>
    <article class="stat-card">
      <div class="stat-label">Medical records</div>
      <div class="stat-value"><%= stats.recordCount %></div>
    </article>
    <article class="stat-card">
      <div class="stat-label">Stock alerts</div>
      <div class="stat-value"><%= stats.lowStockCount %></div>
    </article>
  </section>

  <div class="grid grid-2 mt-2">
    <section class="card">
      <div class="card-header"><h2>Appointment status</h2></div>
      <% const totalAppointments = Object.values(appointmentStatus).reduce((sum, value) => sum + value, 0); %>
      <% if (totalAppointments) { %>
        <ul class="list">
          <% Object.entries(appointmentStatus).forEach(([status, count]) => { %>
            <li class="list-item">
              <div>
                <h4><%= statusLabel(status) %></h4>
                <progress value="<%= count %>" max="<%= totalAppointments %>"></progress>
              </div>
              <span class="badge badge-<%= statusClass(status) %>"><%= count %></span>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p class="muted mb-0">No appointments recorded.</p>
      <% } %>
    </section>

    <section class="card">
      <div class="card-header"><h2>Medicine status</h2></div>
      <% const totalMedicines = Object.values(medicineStatus).reduce((sum, value) => sum + value, 0); %>
      <% if (totalMedicines) { %>
        <ul class="list">
          <% Object.entries(medicineStatus).forEach(([status, count]) => { %>
            <li class="list-item">
              <div>
                <h4><%= statusLabel(status) %></h4>
                <progress value="<%= count %>" max="<%= totalMedicines %>"></progress>
              </div>
              <span class="badge badge-<%= statusClass(status) %>"><%= count %></span>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p class="muted mb-0">No medicines recorded.</p>
      <% } %>
    </section>
  </div>

  <section class="card mt-2">
    <div class="card-header"><h2>Most common diagnoses</h2></div>
    <% if (topDiagnoses.length) { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Diagnosis</th><th>Records</th></tr></thead>
          <tbody>
            <% topDiagnoses.forEach((item) => { %>
              <tr><td><%= item.diagnosis %></td><td><%= item.count %></td></tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="muted mb-0">No diagnosis data available.</p>
    <% } %>
  </section>
</main>

<%- include('../partials/portal-end') %>

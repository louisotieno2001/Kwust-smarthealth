<%- include('../partials/portal-start', { title: 'Health notes' }) %>

<main id="main" class="container">
  <%- include('../partials/flash') %>
  <div class="page-header">
    <div>
      <span class="eyebrow">Personal health</span>
      <h1>Health notes</h1>
      <p>Keep private notes about symptoms, questions, or reminders for your next visit.</p>
    </div>
  </div>

  <div class="split">
    <section class="card">
      <div class="card-header"><h2>Your notes</h2><span class="badge badge-info"><%= notes.length %></span></div>
      <% if (notes.length) { %>
        <div class="stack">
          <% notes.forEach((note) => { %>
            <article class="card note-card">
              <header>
                <div>
                  <h3><%= note.title %></h3>
                  <small class="muted"><%= formatDateTime(note.created_at) %></small>
                </div>
                <form action="/student/notes/<%= note.id %>/delete" method="post" data-confirm="Delete this note?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-ghost btn-sm">Delete</button>
                </form>
              </header>
              <p><%= note.content %></p>
            </article>
          <% }); %>
        </div>
      <% } else { %>
        <div class="empty-state"><strong>No notes yet</strong><span>Add a note to keep track of how you are feeling.</span></div>
      <% } %>
    </section>

    <aside class="card">
      <div class="card-header"><h2>Add a note</h2></div>
      <form action="/student/notes" method="post" class="form" data-submit-once>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="note-title">Title</label>
          <input id="note-title" name="title" type="text" maxlength="120" required>
        </div>
        <div class="field">
          <label for="note-content">Note</label>
          <textarea id="note-content" name="content" rows="6" required placeholder="How are you feeling? What would you like to discuss at your next visit?"></textarea>
        </div>
        <button type="submit" class="btn btn-primary" data-loading-text="Saving...">Save note</button>
      </form>
    </aside>
  </div>
</main>

<%- include('../partials/portal-end') %>
